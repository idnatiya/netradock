# Required. Anyone who logs in gets root-equivalent access to the host, so use a long
# random password (openssl rand -base64 24).
NETRADOCK_USERNAME=admin
NETRADOCK_PASSWORD=change-me

# Preferred over NETRADOCK_PASSWORD: a bcrypt hash, so the password is not readable in
# `docker inspect` or /proc/<pid>/environ. When set, NETRADOCK_PASSWORD is ignored.
# Generate with: make hash  (prompts without echoing, prints the whole line)
# Note: For docker-compose, escape '$' as '$$' (e.g. $$2y$$12$$...) to prevent interpolation.
NETRADOCK_PASSWORD_HASH=

# Signs session cookies. Generate with: openssl rand -hex 32
# Left empty, a random key is used and everyone is logged out on restart.
# Changing the username or password also invalidates every session already issued.
NETRADOCK_SECRET=

# Defaults to true. Only set it to false when serving over plain HTTP, which leaks the
# session cookie to anyone on the network.
NETRADOCK_SECURE_COOKIE=true

# Set to X-Forwarded-For (or X-Real-IP) behind a reverse proxy so the login rate limit sees client IPs.
NETRADOCK_PROXY_HEADER=

# Optional.
NETRADOCK_PORT=8080
# NETRADOCK_SESSION_HOURS=12
# NETRADOCK_LOG_LEVEL=info
