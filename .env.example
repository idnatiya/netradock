# Required.
NETRADOCK_USERNAME=admin
NETRADOCK_PASSWORD=change-me

# Signs session cookies. Generate with: openssl rand -hex 32
# Left empty, a random key is used and everyone is logged out on restart.
NETRADOCK_SECRET=

# Set to true once served over HTTPS.
NETRADOCK_SECURE_COOKIE=false

# Set to X-Forwarded-For (or X-Real-IP) behind a reverse proxy so the login rate limit sees client IPs.
NETRADOCK_PROXY_HEADER=

# Optional.
# NETRADOCK_PORT=8080
# NETRADOCK_SESSION_HOURS=12
# NETRADOCK_LOG_LEVEL=info
